{
	"name": "bookreader",
	"private": true,
	"version": "0.0.1",
	"description": "Mobile PWA for reading EPUB files in the browser, built with Svelte 5 and SvelteKit",
	"license": "MIT",
	"author": "Andrei Krasnikau",
	"repository": {
		"type": "git",
		"url": "https://github.com/krasnikau-andrei/bookreader.git"
	},
	"keywords": [
		"epub",
		"ebook",
		"reader",
		"pwa",
		"svelte",
		"sveltekit"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "playwright install && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "bddgen && playwright test",
		"test": "vitest run",
		"test:unit": "vitest run",
		"check:books": "bun run scripts/check-broken-books.ts",
		"check:books:e2e": "playwright test --config=playwright-check.config.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@storybook/addon-essentials": "8.6.14",
		"@storybook/addon-interactions": "8.6.14",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/svelte-vite": "8.6.14",
		"@storybook/sveltekit": "8.6.14",
		"@storybook/test": "8.6.14",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/jsdom": "^28.0.1",
		"@types/jszip": "^3.4.1",
		"@types/node": "^20",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"jsdom": "^29.0.2",
		"playwright-bdd": "^8.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"storybook": "8.6.14",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"dexie": "^4.4.2",
		"jszip": "^3.10.1"
	}
}
